# Скопируйте в .env и заполните. .env не коммитится.
# Ссылка GET из гайда организаторов (кнопка «Открыть GET для DEV»), group_id подставляется сам
CQA_SOURCE_URL=
# Ключ Claude API (необязательно: без него используется claude -p, если установлен Claude Code)
ANTHROPIC_API_KEY=
# Другой аккаунт для claude -p (например, когда на основном кончился лимит): токен из `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
